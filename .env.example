# ============================================================
# AgentForge 本地配置模板
# 复制本文件为 .env 并填写真实值：
#   cp .env.example .env      （Linux / macOS / Git Bash）
#   Copy-Item .env.example .env（PowerShell）
# .env 已被 .gitignore 排除，不会提交到仓库。
# ============================================================

# --- DeepSeek API（必需，用于生成日报）---
# 获取：登录 https://platform.deepseek.com → API Keys → 创建
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# --- GitHub Token（推荐，用于提高搜索 API 频率限制）---
# 获取：https://github.com/settings/tokens
#   classic token 勾选 public_repo 权限即可（私有仓库也可选 repo）
# 也可留空：匿名搜索限流 10 次/分钟，本 agent 每轮约 8 次查询
GITHUB_TOKEN=

# --- SMTP 邮件（本地测试发信需要）---
# SMTP 服务器：
#   QQ 邮箱     smtp.qq.com        465(SSL) 或 587(STARTTLS)
#   163 邮箱    smtp.163.com       465(SSL) 或 587(STARTTLS)
#   Gmail       smtp.gmail.com     587(STARTTLS)（需应用专用密码）
#   Outlook     smtp-mail.outlook.com 587(STARTTLS)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465

# 发件邮箱地址
SMTP_USER=yourname@example.com
# 邮箱授权码（不是登录密码）！
#   QQ/163：邮箱设置 → 账户 → 开启 SMTP 服务 → 生成授权码
SMTP_PASSWORD=your-smtp-auth-code

# 收件邮箱（多个用英文逗号分隔）
SMTP_TO=yourname@example.com
